   "unit": "1/GeV",
   "meaning": "sagitta / misalignment (CMS M)"
  },
  "a2": {
   "unit": "1 (a^2)",
   "meaning": "a^2: extra curvature resolution, multiple scattering (CMS a)"
  },
  "c2": {
   "unit": "GeV^-2 (c^2)",
   "meaning": "c^2: extra curvature resolution, hit resolution (CMS c)"
  }
 },
